+int
+hev_jni_resolve_owner (int protocol, const char *source_address,
+                       int source_port, const char *destination_address,
+                       int destination_port, char *owner, size_t owner_size)
+{
+    int res = -1;
+
+    if (!owner || owner_size == 0)
+        return -1;
+    owner[0] = '\0';
+
+    pthread_mutex_lock (&owner_mutex);
+    while (owner_resolver_state == 0)
+        pthread_cond_wait (&owner_response_cond, &owner_mutex);
+    while (owner_resolver_state > 0 && owner_request_pending)
+        pthread_cond_wait (&owner_response_cond, &owner_mutex);
+    if (owner_resolver_state < 0)
+        goto exit;
+
+    owner_request.protocol = protocol;
+    owner_request.source_port = source_port;
+    owner_request.destination_port = destination_port;
+    snprintf (owner_request.source_address,
+              sizeof (owner_request.source_address), "%s", source_address);
+    snprintf (owner_request.destination_address,
+              sizeof (owner_request.destination_address), "%s",
+              destination_address);
+    owner_request.result = -1;
+    owner_request_pending = 1;
+    owner_response_ready = 0;
+    pthread_cond_signal (&owner_request_cond);
+    while (!owner_response_ready && owner_resolver_state > 0)
+        pthread_cond_wait (&owner_response_cond, &owner_mutex);
+    if (owner_response_ready && owner_request.result == 0) {
+        snprintf (owner, owner_size, "%s", owner_request.owner);
+        res = owner[0] ? 0 : -1;
+    }
+    owner_request_pending = 0;
+    owner_response_ready = 0;
+    pthread_cond_broadcast (&owner_request_cond);
+    pthread_cond_broadcast (&owner_response_cond);
+
+exit:
+    pthread_mutex_unlock (&owner_mutex);
+    return res;
+}
