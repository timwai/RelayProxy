+static int
+resolve_owner_on_jvm_thread (JNIEnv *env)
+{
+    const char *bytes;
+    jstring source = NULL;
+    jstring destination = NULL;
+    jstring result = NULL;
+    int res = -1;
+
+    owner_request.owner[0] = '\0';
+    source = (*env)->NewStringUTF (env, owner_request.source_address);
+    destination = (*env)->NewStringUTF (env, owner_request.destination_address);
+    if (!source || !destination)
+        goto exit;
+    result = (jstring)(*env)->CallStaticObjectMethod (
+        env, service_class, resolve_owner_method, owner_request.protocol, source,
+        owner_request.source_port, destination, owner_request.destination_port);
+    if ((*env)->ExceptionCheck (env)) {
+        (*env)->ExceptionClear (env);
+        goto exit;
+    }
+    if (!result)
+        goto exit;
+    bytes = (*env)->GetStringUTFChars (env, result, NULL);
+    if (!bytes)
+        goto exit;
+    snprintf (owner_request.owner, sizeof (owner_request.owner), "%s", bytes);
+    (*env)->ReleaseStringUTFChars (env, result, bytes);
+    res = owner_request.owner[0] ? 0 : -1;
+
+exit:
+    if ((*env)->ExceptionCheck (env))
+        (*env)->ExceptionClear (env);
+    if (result)
+        (*env)->DeleteLocalRef (env, result);
+    if (source)
+        (*env)->DeleteLocalRef (env, source);
+    if (destination)
+        (*env)->DeleteLocalRef (env, destination);
+    return res;
+}
