<Window x:Class="RelayProxy.Native.MessagePopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="16" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="PopupTitleBar">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="TypeIconBorder" Width="44" Height="44" CornerRadius="13"
                Background="{ThemeResource AccentFillColorSecondaryBrush}">
          <TextBlock x:Name="TypeIconText" Text="123" FontWeight="SemiBold" FontSize="15"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="3">
          <TextBlock x:Name="TypeText" Text="验证码" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
          <TextBlock x:Name="TitleText" Text="RelayProxy 消息" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="MetaText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Width="32" Height="32"
                Click="Close_Click"/>
      </Grid>

      <TextBlock x:Name="ContentText" Grid.Row="1" Margin="0,18,0,0" FontSize="14" TextWrapping="Wrap"/>

      <Border x:Name="CodePanel" Grid.Row="2" Margin="0,16,0,0" Padding="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" Visibility="Collapsed">
        <TextBlock x:Name="CodeText" HorizontalAlignment="Center" FontSize="32" FontWeight="SemiBold"
                   CharacterSpacing="180"/>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,18,0,0">
        <Button Content="关闭" Click="Close_Click"/>
        <Button x:Name="CopyButton" Content="复制验证码" Style="{StaticResource AccentButtonStyle}" Click="Copy_Click" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
