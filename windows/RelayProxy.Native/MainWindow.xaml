<Window x:Class="RelayProxy.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="26" Height="26" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE72A;" Foreground="White" FontSize="13" />
      </Border>
      <TextBlock Grid.Column="1" Text="RelayProxy" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Ellipse x:Name="AgentStateDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" />
        <TextBlock x:Name="AgentStateText" Text="正在启动 Agent…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="RestartAgentButton" Content="重启 Agent" Visibility="Collapsed" Click="RestartAgent_Click"/>
      </StackPanel>
      <Border x:Name="TitleBarRightInsetSpacer" Grid.Column="3" Width="132" />
    </Grid>

    <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Auto" OpenPaneLength="220" CompactPaneLength="48" CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1040" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="运行概览" Tag="overview" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="身份与设备" Tag="devices"><NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon></NavigationViewItem>

        <NavigationViewItemHeader Content="网络" />
        <NavigationViewItem Content="连接与路径" Tag="connection"><NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="出口选择" Tag="exits"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="本机代理" Tag="proxy"><NavigationViewItem.Icon><FontIcon Glyph="&#xE839;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="本机出口共享" Tag="exitshare"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="分流规则" Tag="routing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;" /></NavigationViewItem.Icon></NavigationViewItem>

        <NavigationViewItemHeader Content="功能" />
        <NavigationViewItem Content="远程桌面" Tag="rdp"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="消息" Tag="messages"><NavigationViewItem.Icon><FontIcon Glyph="&#xE715;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="实时连接" Tag="connections"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="诊断与日志" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid>
        <ScrollViewer x:Name="OverviewView">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="运行概览" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="连接状态、当前出口、数据路径与实时流量" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
              <Button Grid.Column="1" Content="刷新" Click="RefreshOverview_Click" VerticalAlignment="Center" />
            </Grid>
            <InfoBar x:Name="OverviewBar" IsOpen="False" Severity="Warning" Title="Agent 尚未就绪" />
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="15">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock x:Name="ConnectionStateText" Text="正在连接…" FontSize="26" FontWeight="SemiBold" /><TextBlock x:Name="ConnectionMetaText" Text="等待 Agent 状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                  <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="999" Padding="9,5" VerticalAlignment="Top"><TextBlock x:Name="ApprovalText" Text="审批状态未知" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /></Border>
                </Grid>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="42" Height="42" CornerRadius="11" Background="{ThemeResource AccentFillColorSecondaryBrush}"><FontIcon Glyph="&#xE774;" FontSize="18" /></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="ExitNameText" Text="未选择出口" FontWeight="SemiBold" FontSize="15" /><TextBlock x:Name="ExitMetaText" Text="等待服务端授权出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                  <Button Grid.Column="2" Content="切换" Click="OpenExits_Click" VerticalAlignment="Center" />
                </Grid></Border>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="9"><TextBlock Text="数据路径" FontSize="16" FontWeight="SemiBold" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Public Direct" FontWeight="SemiBold" /><TextBlock x:Name="DirectDetailText" Text="等待状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock x:Name="DirectStateText" Grid.Column="1" Text="—" VerticalAlignment="Center" /></Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="P2P QUIC" FontWeight="SemiBold" /><TextBlock x:Name="P2PDetailText" Text="等待状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock x:Name="P2PStateText" Grid.Column="1" Text="—" VerticalAlignment="Center" /></Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Relay" FontWeight="SemiBold" /><TextBlock Text="直连不可用时回退" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="Standby" VerticalAlignment="Center" /></Grid>
              </StackPanel></Border>
            </Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="下载速度" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="DownloadRateText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="上传速度" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="UploadRateText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="往返延迟" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="LatencyText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="SOCKS5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SocksStateText" Text="—" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="HTTP" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="HttpStateText" Text="—" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="网络出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ExitStateText" Text="—" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="活跃转发" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ActiveStreamsText" Text="0" FontWeight="SemiBold" /></StackPanel>
            </Grid></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DevicesView" Visibility="Collapsed">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="身份与设备" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="当前安装身份、设备审批状态与已授权资源" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <Button Grid.Column="1" Content="刷新" Click="RefreshDevices_Click"/>
            </Grid>
            <InfoBar x:Name="DevicesBar" IsOpen="False"/>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="当前设备" FontSize="16" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DeviceNameText" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="IdentityNameText" Text="—" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Border Grid.Column="1" CornerRadius="999" Padding="9,5" Background="{ThemeResource LayerFillColorDefaultBrush}"><TextBlock x:Name="DeviceApprovalText" Text="未知"/></Border></Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="设备 ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DeviceIdText" Grid.Column="1" Text="—" TextWrapping="Wrap"/></Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="传输" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DeviceTransportText" Grid.Column="1" Text="—"/></Grid>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="授权资源" FontSize="16" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="代理出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AuthorizedExitCountText" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="RDP 设备" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AuthorizedRdpCountText" Text="0" FontSize="24" FontWeight="SemiBold"/></StackPanel></Grid>
                <TextBlock Text="这里只展示服务端下发给当前身份 / 当前设备的资源，不会显示未授权设备。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
            </Grid>
            <StackPanel x:Name="AuthorizedResourcesPanel" Spacing="8"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ConnectionView" Visibility="Collapsed">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="连接与路径" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Server、Identity、QUIC/TLS、Public Direct、P2P 与 Relay 回退" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="重新读取" Click="ReloadConfig_Click"/><Button Content="保存连接设置" Style="{StaticResource AccentButtonStyle}" Click="SaveConnection_Click"/></StackPanel>
            </Grid>
            <InfoBar x:Name="ConnectionBar" IsOpen="False"/>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="服务器与设备" FontSize="16" FontWeight="SemiBold"/>
                <TextBox x:Name="ServerAddressBox" Header="Relay Server"/>
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <NumberBox x:Name="QuicPortBox" Header="QUIC / UDP 端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"/>
                  <NumberBox x:Name="TcpPortBox" Grid.Column="1" Header="TCP / TLS 端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"/>
                </Grid>
                <ComboBox x:Name="TransportCombo" Header="传输方式" HorizontalAlignment="Stretch"><ComboBoxItem Tag="auto" Content="自动 · 优先 QUIC，失败回退 TLS"/><ComboBoxItem Tag="quic_only" Content="仅 QUIC"/><ComboBoxItem Tag="tcp_only" Content="仅 TCP/TLS"/></ComboBox>
                <ToggleSwitch x:Name="TlsSwitch" Header="启用 TLS"/>
                <TextBox x:Name="DeviceNameBox" Header="设备名称"/>
                <TextBox x:Name="IdentityBox" Header="Identity ID"/>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="路径策略" FontSize="16" FontWeight="SemiBold"/>
                <ToggleSwitch x:Name="P2PEnabledSwitch" Header="启用 P2P / Public Direct 直连能力"/>
                <ComboBox x:Name="P2PModeCombo" Header="路径模式" HorizontalAlignment="Stretch"><ComboBoxItem Tag="auto" Content="自动 · Public Direct → P2P → Relay"/><ComboBoxItem Tag="direct_only" Content="仅直连 · 不回退 Relay"/><ComboBoxItem Tag="p2p_only" Content="仅 P2P"/><ComboBoxItem Tag="relay_only" Content="仅 Relay"/></ComboBox>
                <ToggleSwitch x:Name="P2PFallbackSwitch" Header="自动回退 Relay"/>
                <TextBox x:Name="PublicAdvertiseBox" Header="手动公网地址（可选）" PlaceholderText="edge.example.com:443"/>
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <NumberBox x:Name="PunchTimeoutBox" Header="打洞超时 ms" Minimum="100" Maximum="60000"/>
                  <NumberBox x:Name="IdleTimeoutBox" Grid.Column="1" Header="空闲回收 s" Minimum="1" Maximum="3600"/>
                  <NumberBox x:Name="MaxSessionsBox" Grid.Column="2" Header="最多 Exit 会话" Minimum="1" Maximum="64"/>
                </Grid>
                <TextBlock Text="Windows 不提供 Android 的 Wi‑Fi / 移动数据网络调度；这里只配置 RelayProxy 数据路径。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ExitsView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="出口选择" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="当前身份与显式授权出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Grid.Column="1" Content="刷新" Click="RefreshExits_Click" /></Grid><InfoBar x:Name="ExitsBar" IsOpen="False" /><StackPanel x:Name="ExitsPanel" Spacing="10" /></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="ProxyView" Visibility="Collapsed">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="本机代理" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="SOCKS5 / HTTP 独立控制，以及 Windows 系统透明代理" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <Button Grid.Column="1" Content="保存代理设置" Style="{StaticResource AccentButtonStyle}" Click="SaveProxy_Click"/>
            </Grid>
            <InfoBar x:Name="ProxyBar" IsOpen="False"/>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SOCKS5" FontSize="16" FontWeight="SemiBold"/><ToggleSwitch x:Name="SocksEnabledSwitch" Grid.Column="1"/></Grid>
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="SocksListenBox" Header="监听地址"/><NumberBox x:Name="SocksPortBox" Grid.Column="1" Header="端口" Minimum="1" Maximum="65535"/></Grid>
                <TextBlock Text="支持 TCP 与 UDP ASSOCIATE；socks5h 可由出口解析域名。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="HTTP / HTTPS CONNECT" FontSize="16" FontWeight="SemiBold"/><ToggleSwitch x:Name="HttpEnabledSwitch" Grid.Column="1"/></Grid>
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="HttpListenBox" Header="监听地址"/><NumberBox x:Name="HttpPortBox" Grid.Column="1" Header="端口" Minimum="1" Maximum="65535"/></Grid>
                <TextBlock Text="普通 HTTP 代理与 HTTPS CONNECT 隧道。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Windows 系统透明代理" FontSize="16" FontWeight="SemiBold"/>
              <ToggleSwitch x:Name="TransparentProxySwitch" Header="启用系统透明代理（WinDivert）"/>
              <TextBox x:Name="ExcludeProcessesBox" Header="排除进程" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" PlaceholderText="relayproxy.exe&#10;updater.exe"/>
              <TextBlock Text="按进程代理 TCP / UDP；本程序及控制连接保持直连。Windows x64 使用独立 RelayProxy Network Service 承载需要管理员权限的抓包能力。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="5"><TextBlock Text="RelayProxy Network Service" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="NetworkServiceStateText" Text="正在读取服务状态…" FontWeight="SemiBold"/><TextBlock x:Name="NetworkServiceDetailText" Text="WinDivert 提权服务状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="刷新" Click="RefreshNetworkService_Click"/><Button x:Name="RepairNetworkServiceButton" Content="安装 / 修复" Style="{StaticResource AccentButtonStyle}" Click="RepairNetworkService_Click"/><Button x:Name="UninstallNetworkServiceButton" Content="卸载" Click="UninstallNetworkService_Click"/></StackPanel>
            </Grid></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ExitShareView" Visibility="Collapsed">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="本机出口共享" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="允许其他授权设备通过本机访问互联网、私网或回环服务" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <Button Grid.Column="1" Content="保存出口设置" Style="{StaticResource AccentButtonStyle}" Click="SaveExitShare_Click"/>
            </Grid>
            <InfoBar x:Name="ExitShareBar" IsOpen="False"/>
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="出口权限" FontSize="16" FontWeight="SemiBold"/>
                <ToggleSwitch x:Name="ExitEnabledSwitch" Header="启用本机作为 Exit"/>
                <CheckBox x:Name="AllowInternetCheck" Content="允许访问互联网"/>
                <CheckBox x:Name="AllowPrivateCheck" Content="允许访问私有网络"/>
                <CheckBox x:Name="AllowLoopbackCheck" Content="允许访问本机回环地址"/>
                <TextBlock Text="最终权限仍受服务端设备能力与身份策略约束。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="上游代理" FontSize="16" FontWeight="SemiBold"/>
                <ComboBox x:Name="ExitUpstreamModeCombo" Header="访问方式" HorizontalAlignment="Stretch"><ComboBoxItem Tag="" Content="本机直连"/><ComboBoxItem Tag="socks5" Content="SOCKS5 上游"/><ComboBoxItem Tag="http" Content="HTTP 上游"/></ComboBox>
                <TextBox x:Name="ExitUpstreamAddressBox" Header="上游地址" PlaceholderText="host:port"/>
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="ExitUpstreamUserBox" Header="用户名"/><PasswordBox x:Name="ExitUpstreamPasswordBox" Grid.Column="1" Header="密码"/></Grid>
                <TextBlock Text="上游代理模式只支持 TCP；UDP 会明确拒绝，不会绕过代理直连。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="域名与 IP 访问规则" FontSize="16" FontWeight="SemiBold"/>
              <ComboBox x:Name="AccessModeCombo" Header="匹配模式" HorizontalAlignment="Stretch"><ComboBoxItem Tag="" Content="不附加筛选"/><ComboBoxItem Tag="allow" Content="允许列表"/><ComboBoxItem Tag="deny" Content="拒绝列表"/></ComboBox>
              <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="AccessDomainsBox" Header="域名（每行一条）" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap"/><TextBox x:Name="AccessCidrsBox" Grid.Column="1" Header="IP / CIDR / 范围（每行一条）" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap"/></Grid>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RoutingView" Visibility="Collapsed">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="分流规则" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="第一条启用且匹配的规则生效；支持进程、目标、端口、协议与指定出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="添加规则" Click="AddRule_Click"/><Button Content="保存并应用" Style="{StaticResource AccentButtonStyle}" Click="SaveRouting_Click"/></StackPanel>
            </Grid>
            <InfoBar x:Name="RoutingBar" IsOpen="False"/>
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="RoutingModeCombo" Header="路由模式" HorizontalAlignment="Stretch"><ComboBoxItem Tag="rule" Content="按规则分流"/><ComboBoxItem Tag="global_proxy" Content="全局代理"/><ComboBoxItem Tag="direct" Content="全局直连"/></ComboBox>
              <ComboBox x:Name="DefaultActionCombo" Grid.Column="1" Header="未命中时" HorizontalAlignment="Stretch"><ComboBoxItem Tag="PROXY" Content="代理"/><ComboBoxItem Tag="DIRECT" Content="直连"/><ComboBoxItem Tag="REJECT" Content="拒绝"/></ComboBox>
            </Grid></Border>
            <StackPanel x:Name="RoutingRulesPanel" Spacing="8"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RdpView" Visibility="Collapsed">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="远程桌面" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="只显示服务端明确授权给当前 Agent 的 RDP 设备" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="刷新" Click="RefreshRdp_Click"/><Button Content="断开当前 RDP" Click="DisconnectRdp_Click"/></StackPanel>
            </Grid>
            <InfoBar x:Name="RdpBar" IsOpen="False"/>
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="本地入口" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="RdpListenText" Text="—" FontWeight="SemiBold"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="TCP 路径" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="RdpTcpPathText" Text="—" FontWeight="SemiBold"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="UDP 状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="RdpUdpText" Text="—" FontWeight="SemiBold"/></StackPanel>
            </Grid></Border>
            <StackPanel x:Name="RdpTargetsPanel" Spacing="8"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ConnectionsView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="实时连接" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="进程、目标、规则、出口与数据路径" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="刷新" Click="RefreshConnections_Click" /><Button Content="清空记录" Click="ClearConnections_Click" /></StackPanel></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="活跃连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ActiveConnectionsText" Text="0" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="下载" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ConnectionsDownText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="上传" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ConnectionsUpText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border></Grid><StackPanel x:Name="ConnectionsPanel" Spacing="8" /></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="MessagesView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="消息" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="验证码、普通消息与重要提醒；弹窗已改为 WinUI 原生窗口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="刷新" Click="RefreshMessages_Click" /><Button Content="清空历史" Click="ClearMessages_Click" /></StackPanel></Grid><InfoBar x:Name="MessagesBar" IsOpen="False" /><StackPanel x:Name="MessagesPanel" Spacing="8" /></StackPanel></ScrollViewer>

        <ScrollViewer x:Name="DiagnosticsView" Visibility="Collapsed">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="诊断与日志" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="控制连接、Public Direct、P2P、透明代理、RDP 与运行日志" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="刷新" Click="RefreshDiagnostics_Click"/><Button Content="清空日志" Click="ClearLogs_Click"/></StackPanel>
            </Grid>
            <InfoBar x:Name="DiagnosticsBar" IsOpen="False"/>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="控制连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DiagControlText" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="数据路径" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DiagPathText" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="活跃连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DiagConnectionsText" Text="0" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold"/><TextBox x:Name="LogsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" MinHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><StackPanel><TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Windows 原生 GUI 行为" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><InfoBar x:Name="SettingsBar" IsOpen="False"/><Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="Agent 连接" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ManagementUrlText" Text="尚未连接" /><TextBlock x:Name="SettingsAgentStateText" Text="未启动" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Grid.Column="1" Content="打开配置目录" Click="OpenConfigDirectory_Click" VerticalAlignment="Center"/></Grid></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="窗口与托盘" FontSize="16" FontWeight="SemiBold"/><ToggleSwitch x:Name="AutostartSwitch" Header="开机自动启动" Toggled="AutostartSwitch_Toggled"/><ToggleSwitch x:Name="MinimizeToTraySwitch" Header="关闭窗口时最小化到托盘"/><ComboBox x:Name="ThemeCombo" Header="主题" HorizontalAlignment="Stretch"><ComboBoxItem Tag="system" Content="跟随系统"/><ComboBoxItem Tag="light" Content="浅色"/><ComboBoxItem Tag="dark" Content="深色"/></ComboBox><NumberBox x:Name="PopupTimeoutBox" Header="消息弹窗自动关闭 / 秒（0 = 不自动关闭）" Minimum="0" Maximum="3600"/><Button Content="保存 GUI 设置" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveGuiSettings_Click"/></StackPanel></Border>
        </StackPanel></ScrollViewer>


      </Grid>
    </NavigationView>
  </Grid>
</Window>
