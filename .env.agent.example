# Copy to .env.agent and use: docker compose --env-file .env.agent -f docker-compose.agent.yml up -d --build
# Leave optional values blank to retain the mounted relay-agent.yaml settings.

# Host directories; mount the entire configuration directory (not one YAML file).
RELAY_AGENT_BIN_DIR=./bin
RELAY_AGENT_CONFIG_DIR=./config
RELAY_AGENT_IMAGE=relayproxy-agent-runtime:alpine

# Server-generated 16-character identity ID; may also be entered in the Web UI.
RELAY_AGENT_SERVER=
RELAY_AGENT_SERVER_TCP_PORT=
RELAY_AGENT_SERVER_QUIC_PORT=
RELAY_AGENT_SERVER_TLS_ENABLED=
RELAY_AGENT_INSECURE_TLS=
RELAY_AGENT_DEVICE_NAME=
RELAY_AGENT_IDENTITY_ID=
RELAY_AGENT_TRANSPORT_MODE=
RELAY_AGENT_DEFAULT_EXIT=

# true enables IPv4 transparent proxying; false disables it; blank keeps YAML.
# Host NFQUEUE support and NET_ADMIN + NET_RAW capabilities are still required.
RELAY_AGENT_TRANSPARENT_PROXY=

RELAY_AGENT_SOCKS5_ENABLED=
RELAY_AGENT_SOCKS5_LISTEN=
RELAY_AGENT_SOCKS5_PORT=
RELAY_AGENT_HTTP_ENABLED=
RELAY_AGENT_HTTP_LISTEN=
RELAY_AGENT_HTTP_PORT=

# The default Web listener stays on 127.0.0.1:9090. For LAN management, set
# WEB_LISTEN to 0.0.0.0 and supply a random WEB_TOKEN of at least 32 bytes.
# Single-quote values containing $ or # so Compose preserves them literally.
RELAY_AGENT_WEB_ENABLED=
RELAY_AGENT_WEB_LISTEN=
RELAY_AGENT_WEB_PORT=
RELAY_AGENT_WEB_TOKEN=
