<Window x:Class="RelayProxy.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Padding="16,0,8,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="26" Height="26" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE72A;" Foreground="White" FontSize="13" />
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="RelayProxy" FontWeight="SemiBold" /><TextBlock Text="Native" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,132,0">
        <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
        <TextBlock x:Name="AgentStateText" Text="正在启动 Agent…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Grid>

    <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Left" OpenPaneLength="220" CompactPaneLength="48" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="运行概览" Tag="overview" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="身份与设备" Tag="devices"><NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="连接与路径" Tag="connection"><NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="出口选择" Tag="exits"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="本机代理" Tag="proxy"><NavigationViewItem.Icon><FontIcon Glyph="&#xE839;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="本机出口共享" Tag="exitshare"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="分流规则" Tag="routing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="远程桌面" Tag="rdp"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="消息" Tag="messages"><NavigationViewItem.Icon><FontIcon Glyph="&#xE715;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="实时连接" Tag="connections"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="诊断与日志" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid>
        <ScrollViewer x:Name="OverviewView">
          <StackPanel Padding="28" Spacing="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="运行概览" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="连接状态、当前出口、数据路径与实时流量" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
              <Button Grid.Column="1" Content="刷新" Click="RefreshOverview_Click" VerticalAlignment="Center" />
            </Grid>
            <InfoBar x:Name="OverviewBar" IsOpen="False" Severity="Warning" Title="Agent 尚未就绪" />
            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="15">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock x:Name="ConnectionStateText" Text="正在连接…" FontSize="26" FontWeight="SemiBold" /><TextBlock x:Name="ConnectionMetaText" Text="等待 Agent 状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                  <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="999" Padding="9,5" VerticalAlignment="Top"><TextBlock x:Name="ApprovalText" Text="审批状态未知" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /></Border>
                </Grid>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="42" Height="42" CornerRadius="11" Background="{ThemeResource AccentFillColorSecondaryBrush}"><FontIcon Glyph="&#xE774;" FontSize="18" /></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="ExitNameText" Text="未选择出口" FontWeight="SemiBold" FontSize="15" /><TextBlock x:Name="ExitMetaText" Text="等待服务端授权出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                  <Button Grid.Column="2" Content="切换" Click="OpenExits_Click" VerticalAlignment="Center" />
                </Grid></Border>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="9"><TextBlock Text="数据路径" FontSize="16" FontWeight="SemiBold" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Public Direct" FontWeight="SemiBold" /><TextBlock x:Name="DirectDetailText" Text="等待状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock x:Name="DirectStateText" Grid.Column="1" Text="—" VerticalAlignment="Center" /></Grid>
                <Separator /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="P2P QUIC" FontWeight="SemiBold" /><TextBlock x:Name="P2PDetailText" Text="等待状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock x:Name="P2PStateText" Grid.Column="1" Text="—" VerticalAlignment="Center" /></Grid>
                <Separator /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Relay" FontWeight="SemiBold" /><TextBlock Text="直连不可用时回退" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="Standby" VerticalAlignment="Center" /></Grid>
              </StackPanel></Border>
            </Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="下载速度" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="DownloadRateText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="上传速度" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="UploadRateText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="往返延迟" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="LatencyText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="SOCKS5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SocksStateText" Text="—" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="HTTP" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="HttpStateText" Text="—" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="网络出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ExitStateText" Text="—" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="活跃转发" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ActiveStreamsText" Text="0" FontWeight="SemiBold" /></StackPanel>
            </Grid></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ExitsView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="出口选择" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="当前身份与显式授权出口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Grid.Column="1" Content="刷新" Click="RefreshExits_Click" /></Grid><InfoBar x:Name="ExitsBar" IsOpen="False" /><StackPanel x:Name="ExitsPanel" Spacing="10" /></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="ConnectionsView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="实时连接" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="进程、目标、规则、出口与数据路径" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Grid.Column="1" Content="刷新" Click="RefreshConnections_Click" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="活跃连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ActiveConnectionsText" Text="0" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="下载" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ConnectionsDownText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="上传" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ConnectionsUpText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border></Grid><StackPanel x:Name="ConnectionsPanel" Spacing="8" /></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="MessagesView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="消息" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="验证码、普通消息与重要提醒" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="刷新" Click="RefreshMessages_Click" /><Button Content="清空历史" Click="ClearMessages_Click" /></StackPanel></Grid><InfoBar x:Name="MessagesBar" IsOpen="False" /><StackPanel x:Name="MessagesPanel" Spacing="8" /></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14"><StackPanel><TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="原生 GUI 运行环境与迁移状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Agent 连接" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ManagementUrlText" Text="尚未连接" /><TextBlock x:Name="SettingsAgentStateText" Text="未启动" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border><InfoBar IsOpen="True" Severity="Informational" Title="第一阶段" Message="运行概览、出口、实时连接、消息已经接入真实 Go Agent；其余功能继续按完整 HTML 原型逐页迁移。" /></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="PlaceholderView" Visibility="Collapsed"><StackPanel Padding="28" Spacing="14" MaxWidth="760" HorizontalAlignment="Left"><TextBlock x:Name="PlaceholderTitle" Text="模块" FontSize="28" FontWeight="SemiBold" /><TextBlock x:Name="PlaceholderDescription" Text="正在迁移到 WinUI 3 原生实现。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="迁移原则" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="• UI 使用 WinUI 3 / Fluent，不再嵌 WebView。" /><TextBlock Text="• Go 网络核心、认证、QUIC、P2P、透明代理和 RDP 继续复用。" /><TextBlock Text="• 旧 Wails GUI 在功能完全对等前保留回退。" /><TextBlock Text="• 交互与信息架构以 docs/prototypes/relayproxy-complete-ui-prototype.html 为基准。" /></StackPanel></Border></StackPanel></ScrollViewer>
      </Grid>
    </NavigationView>
  </Grid>
</Window>