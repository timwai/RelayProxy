 static atomic_int is_running;
 static int thread_joinable;
 static JavaVM *java_vm;
+static jclass service_class;
+static jmethodID resolve_owner_method;
 static pthread_t work_thread;
 static pthread_mutex_t mutex;
 static pthread_key_t current_jni_env;
@@ -85,6 +87,14 @@ JNI_OnLoad (JavaVM *vm, void *reserved)
     klass = (*env)->FindClass (env, STR (PKGNAME) "/" STR (CLSNAME));
     if (!klass)
         return JNI_ERR;
+    service_class = (*env)->NewGlobalRef (env, klass);
+    resolve_owner_method = (*env)->GetStaticMethodID (
+        env, klass, "TProxyResolveOwner",
+        "(ILjava/lang/String;ILjava/lang/String;I)Ljava/lang/String;");
+    if (!service_class || !resolve_owner_method) {
+        (*env)->DeleteLocalRef (env, klass);
+        return JNI_ERR;
+    }
     res = (*env)->RegisterNatives (env, klass, native_methods,
                                    N_ELEMENTS (native_methods));
     (*env)->DeleteLocalRef (env, klass);
@@ -97,6 +107,73 @@ JNI_OnLoad (JavaVM *vm, void *reserved)
     return JNI_VERSION_1_4;
 }
 
+static JNIEnv *
+get_current_env (void)
+{
+    JNIEnv *env = pthread_getspecific (current_jni_env);
+    jint res;
+
+    if (env)
+        return env;
+    res = (*java_vm)->AttachCurrentThread (java_vm, (void **)&env, NULL);
+    if (res != JNI_OK)
+        return NULL;
+    pthread_setspecific (current_jni_env, env);
+    return env;
+}
+
+int
+hev_jni_resolve_owner (int protocol, const char *source_address,
+                       int source_port, const char *destination_address,
+                       int destination_port, char *owner, size_t owner_size)
+{
+    const char *bytes;
+    JNIEnv *env;
+    jstring source = NULL;
+    jstring destination = NULL;
+    jstring result;
+
+    if (!owner || owner_size == 0)
+        return -1;
+    owner[0] = '\0';
+    env = get_current_env ();
+    if (!env)
+        return -1;
+    source = (*env)->NewStringUTF (env, source_address);
+    destination = (*env)->NewStringUTF (env, destination_address);
+    if (!source || !destination)
+        goto error;
+    result = (jstring)(*env)->CallStaticObjectMethod (
+        env, service_class, resolve_owner_method, protocol, source, source_port,
+        destination, destination_port);
+    if ((*env)->ExceptionCheck (env)) {
+        (*env)->ExceptionClear (env);
+        goto error;
+    }
+    if (!result)
+        goto error;
+    bytes = (*env)->GetStringUTFChars (env, result, NULL);
+    if (!bytes) {
+        (*env)->DeleteLocalRef (env, result);
+        goto error;
+    }
+    snprintf (owner, owner_size, "%s", bytes);
+    (*env)->ReleaseStringUTFChars (env, result, bytes);
+    (*env)->DeleteLocalRef (env, result);
+    (*env)->DeleteLocalRef (env, source);
+    (*env)->DeleteLocalRef (env, destination);
+    return owner[0] ? 0 : -1;
+
+error:
+    if ((*env)->ExceptionCheck (env))
+        (*env)->ExceptionClear (env);
+    if (source)
+        (*env)->DeleteLocalRef (env, source);
+    if (destination)
+        (*env)->DeleteLocalRef (env, destination);
+    return -1;
+}
