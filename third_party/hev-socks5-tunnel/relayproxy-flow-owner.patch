+static void *
+owner_resolver_thread_handler (void *data)
+{
+    JNIEnv *env = NULL;
+    jint attach_res;
+
+    /* Hev protocol callbacks run on user-space task stacks. Perform JNI
+     * transitions from this regular pthread so ART can safely walk it. */
+    attach_res = (*java_vm)->AttachCurrentThreadAsDaemon (java_vm, &env, NULL);
+    pthread_mutex_lock (&owner_mutex);
+    owner_resolver_state = (attach_res == JNI_OK) ? 1 : -1;
+    pthread_cond_broadcast (&owner_response_cond);
+    while (owner_resolver_state > 0) {
+        while (!owner_request_pending || owner_response_ready)
+            pthread_cond_wait (&owner_request_cond, &owner_mutex);
+        owner_request.result = resolve_owner_on_jvm_thread (env);
+        owner_response_ready = 1;
+        pthread_cond_broadcast (&owner_response_cond);
+    }
+    pthread_mutex_unlock (&owner_mutex);
+    return NULL;
+}
