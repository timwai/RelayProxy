<resources>
    <style name="Theme.RelayProxy.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B4C3D7</item>
        <item name="android:colorAccent">@color/relay_brand</item>
        <item name="android:statusBarColor">@color/relay_background</item>
        <item name="android:navigationBarColor">@color/relay_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/relay_background</item>
    </style>

    <style name="Theme.RelayProxy.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorPrimary">#0F172A</item>
        <item name="android:textColorSecondary">#64748B</item>
        <item name="android:colorAccent">@color/relay_brand</item>
        <item name="android:statusBarColor">@color/relay_background_light</item>
        <item name="android:navigationBarColor">@color/relay_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/relay_background_light</item>
    </style>

    <style name="Theme.RelayProxy.Base" parent="Theme.RelayProxy.Dark" />
    <style name="Theme.RelayProxy" parent="Theme.RelayProxy.Dark" />
</resources>
